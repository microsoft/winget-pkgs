grab collections

make crawled_urls becomes collections.ConcurrentMap()
make url_queue becomes collections.ConcurrentQueue()

url_queue.push("https://example.com/page1")
url_queue.push("https://example.com/page2")

make q_cnt becomes url_queue.count()
say "Queue count: " + q_cnt

make item becomes url_queue.pop()
say "Popped: " + item

crawled_urls.insert(item, "STATUS_200_OK")
say "Inserted into map, map count: " + crawled_urls.count()
