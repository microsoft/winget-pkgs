note VSS Filesystem Standard Library
task exists_file needs path
    send __exists(path)
finish

task read_file needs path
    send __read(path)
finish

task write_file needs path, content
    send __write(content, path)
finish

task files needs dir
    send __file_list(dir)
finish

task create_directory needs path
    send __make_dir(path)
finish

task delete_file needs path
    send __erase(path)
finish

