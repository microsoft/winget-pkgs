note VSS Cross-Platform File Path Standard Library Module
task join needs p1, p2
    send __path_join(p1, p2)
finish

task basename needs p
    send __path_basename(p)
finish

task dirname needs p
    send __path_dirname(p)
finish

task ext needs p
    send __path_ext(p)
finish

task is_file needs p
    send __path_is_file(p)
finish
