note VSS Matrix & Numerical Computation Library

task create needs rows, cols, fill
    send __matrix_create(rows, cols, fill)
finish

task multiply needs m1, m2
    send __matrix_multiply(m1, m2)
finish

task mat_add needs m1, m2
    send __matrix_add(m1, m2)
finish

task transpose needs m
    send __matrix_transpose(m)
finish

task dot needs v1, v2
    send __matrix_dot(v1, v2)
finish

task scale needs m, factor
    send __matrix_scale(m, factor)
finish

task identity needs dim
    make m becomes __matrix_create(dim, dim, 0)
    repeat i through 0 to (dim - 1)
        m[i][i] becomes 1
    finish
    send m
finish
