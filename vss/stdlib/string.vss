note VSS String Standard Library
task length needs s
    send __string_length(s)
finish

task lower needs s
    send __string_lower(s)
finish

task upper needs s
    send __string_upper(s)
finish

task trim needs s
    send __string_trim(s)
finish

task substring needs s, start, len
    send __string_substring(s, start, len)
finish

task find needs s, sub
    send __string_find(s, sub)
finish

task replace needs s, old, new
    send __string_replace(s, old, new)
finish

task split needs s, sep
    send __string_split(s, sep)
finish

task join needs list, sep
    send __string_join(list, sep)
finish

task startswith needs s, prefix
    send __string_startswith(s, prefix)
finish

task endswith needs s, suffix
    send __string_endswith(s, suffix)
finish

task isalpha needs s
    send __string_isalpha(s)
finish

task isdigit needs s
    send __string_isdigit(s)
finish

task count needs s, sub
    send __string_count(s, sub)
finish
