note VSS Collections Standard Library
shape Queue
    field items
    task init needs
        mine.items becomes []
    finish
    task push needs x
        put x into mine.items
    finish
    task pop needs
        when size of mine.items above 0
            send __list_pop_front(mine.items)
        finish
        send empty
    finish
finish

shape Stack
    field items
    task init needs
        mine.items becomes []
    finish
    task push needs x
        put x into mine.items
    finish
    task pop needs
        when size of mine.items above 0
            send __list_pop_back(mine.items)
        finish
        send empty
    finish
finish

task pop_front needs items
    send __list_pop_front(items)
finish

task pop_back needs items
    send __list_pop_back(items)
finish

task remove_at needs items, index
    send __list_remove_at(items, index)
finish

task set_union needs s1, s2
    make union becomes {}
    repeat each x in s1
        make found becomes no
        repeat each u in union
            when u same_as x
                found becomes yes
            finish
        finish
        when found same_as no
            put x into union
        finish
    finish
    repeat each x in s2
        make found becomes no
        repeat each u in union
            when u same_as x
                found becomes yes
            finish
        finish
        when found same_as no
            put x into union
        finish
    finish
    send union
finish
