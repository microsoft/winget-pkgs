note VSS Unit Testing Framework
task assert_equal needs actual, expected, message
    when actual same_as expected
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected " + expected + ", got " + actual + ")"
    finish
finish

task assert_not_equal needs actual, expected, message
    when actual not_same_as expected
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected value to not equal " + expected + ")"
    finish
finish

task assert_true needs condition, message
    when condition same_as yes
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected yes, got " + condition + ")"
    finish
finish

task assert_false needs condition, message
    when condition same_as no
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected no, got " + condition + ")"
    finish
finish

task assert_greater needs a, b, message
    when a above b
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected " + a + " to be greater than " + b + ")"
    finish
finish

task assert_less needs a, b, message
    when a below b
        say "  [PASS] " + message
    otherwise
        say "  [FAIL] " + message + " (Expected " + a + " to be less than " + b + ")"
    finish
finish

task run_suite needs name, tests_list
    say "Running Test Suite: " + name
    repeat each t in tests_list
        t()
    finish
finish
