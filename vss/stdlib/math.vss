note VSS Math Standard Library
task sin needs x
    send __math_sin(x)
finish

task cos needs x
    send __math_cos(x)
finish

task tan needs x
    send __math_tan(x)
finish

task sqrt needs x
    send __math_sqrt(x)
finish

task log needs x
    send __math_log(x)
finish

task ceil needs x
    send __math_ceil(x)
finish

task floor needs x
    send __math_floor(x)
finish

task pow needs base, exp
    send __math_pow(base, exp)
finish

task abs needs x
    send __math_abs(x)
finish

task min needs a, b
    send __math_min(a, b)
finish

task max needs a, b
    send __math_max(a, b)
finish

task sum needs list
    send __math_sum(list)
finish

task round needs val, decimals
    send __math_round(val, decimals)
finish
