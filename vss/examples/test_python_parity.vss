note VSS Python Parity Capabilities Test Suite

grab math
grab string
grab collections
grab testing

say "========================================"
say "VSS Python Parity Feature Test Suite"
say "========================================"

say "1. Testing Global Range & Enumeration..."
make r becomes range(1, 6)
testing.assert_equal(size of r, 5, "range(1, 6) produces 5 elements")
testing.assert_equal(r[0], 1, "range first element is 1")
testing.assert_equal(r[4], 5, "range last element is 5")

make enum_items becomes enumerate(["apple", "banana"])
testing.assert_equal(size of enum_items, 2, "enumerate produces 2 index-value maps")
testing.assert_equal(enum_items[0] field "index", 0, "enumerate index 0")
testing.assert_equal(enum_items[0] field "value", "apple", "enumerate value apple")

say "2. Testing Global Sequences & Sorting..."
make rev becomes reversed([10, 20, 30])
testing.assert_equal(rev[0], 30, "reversed first item is 30")
testing.assert_equal(rev[2], 10, "reversed last item is 10")

make s_list becomes sorted([42, 12, 88, 5])
testing.assert_equal(s_list[0], 5, "sorted min element is 5")
testing.assert_equal(s_list[3], 88, "sorted max element is 88")

say "3. Testing Global Math & Aggregations..."
testing.assert_equal(abs(-42), 42, "abs(-42) should be 42")
testing.assert_equal(min(15, 3), 3, "min(15, 3) should be 3")
testing.assert_equal(max(15, 3), 15, "max(15, 3) should be 15")
testing.assert_equal(sum([10, 20, 30]), 60, "sum([10, 20, 30]) should be 60")
testing.assert_equal(round(3.14159, 2), 3.14, "round(3.14159, 2) should be 3.14")

say "4. Testing Type Inspection..."
testing.assert_equal(type_of(100), "number", "type_of(100) is number")
testing.assert_equal(type_of("hello"), "string", "type_of('hello') is string")
testing.assert_equal(type_of([1, 2]), "list", "type_of([1, 2]) is list")

say "5. Testing String Utilities..."
testing.assert_equal(string.startswith("VSS Language", "VSS"), yes, "string.startswith VSS")
testing.assert_equal(string.endswith("VSS Language", "Language"), yes, "string.endswith Language")
testing.assert_equal(string.isalpha("VSS"), yes, "string.isalpha VSS")
testing.assert_equal(string.isdigit("12345"), yes, "string.isdigit 12345")
testing.assert_equal(string.count("banana", "a"), 3, "string.count 'a' in 'banana'")

say "6. Testing Map & Collection Utilities..."
make user_map becomes map [ "name": "VSS Developer" "role": "Architect" ]
make m_keys becomes collections.keys(user_map)
testing.assert_equal(size of m_keys, 2, "map keys count is 2")
make user_role becomes collections.get(user_map, "role", "Guest")
testing.assert_equal(user_role, "Architect", "collections.get existing key")
make user_dept becomes collections.get(user_map, "dept", "Engineering")
testing.assert_equal(user_dept, "Engineering", "collections.get fallback default")

say "========================================"
say "All Python Parity Tests Passed Successfully!"
say "========================================"
