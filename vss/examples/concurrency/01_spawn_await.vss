note VSS 3.1 Concurrency - Task Spawn and Await

task compute_sum needs limit
    make total becomes 0
    repeat count through 1 to limit
        total becomes total + count
    finish
    send total
finish

say "Spawning background computational tasks..."
make handle1 becomes start compute_sum(100)
make handle2 becomes start compute_sum(200)

say "Awaiting task results..."
make res1 becomes await handle1
make res2 becomes await handle2

say "Result 1 (Sum 1..100): " + res1
say "Result 2 (Sum 1..200): " + res2
say "Spawn and Await Completed Successfully!"
