note VSS 3.1 Concurrency - Parallel Each Loop Execution

task process_number needs n
    make square becomes n * n
    say "Parallel processing item " + n + " -> Square: " + square
    send square
finish

make numbers becomes [1, 2, 3, 4, 5, 6, 7, 8]
say "Processing numbers in parallel across worker pool..."

parallel each num in numbers
    process_number(num)
finish

say "Parallel Each Processing Completed Successfully!"
