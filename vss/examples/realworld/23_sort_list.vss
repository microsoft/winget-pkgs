note 23_sort_list.vss — Bubble Sort Algorithm
task bubble_sort needs items
    make n becomes size of items
    repeat i through 0 to n - 1
        make max_j becomes n - i - 2
        when max_j at_least 0
            repeat j through 0 to max_j
                when items[j] above items[j + 1]
                    make temp becomes items[j]
                    items[j] becomes items[j + 1]
                    items[j + 1] becomes temp
                finish
            finish
        finish
    finish
    send items
finish

make numbers becomes [64, 34, 25, 12, 22, 11, 90]
say "Original: " + numbers
make sorted becomes bubble_sort(numbers)
say "Sorted: " + sorted
