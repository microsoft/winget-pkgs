note 07_grade_calc.vss — Grade Calculator
task get_grade needs score
    when score at_least 90
        send "A"
    orwhen score at_least 80
        send "B"
    orwhen score at_least 70
        send "C"
    orwhen score at_least 60
        send "D"
    otherwise
        send "F"
    finish
finish

say "Score 95 Grade: " + get_grade(95)
say "Score 82 Grade: " + get_grade(82)
say "Score 58 Grade: " + get_grade(58)
