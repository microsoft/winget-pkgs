note 27_file_writer.vss — File Writing Utility
make log_path becomes "app.log"
make log_msg becomes "[INFO] Application started successfully at runtime.\n"

filesystem.write_file(log_path, log_msg)
say "Logged message to " + log_path

when filesystem.exists_file(log_path) same_as yes
    filesystem.delete_file(log_path)
finish
