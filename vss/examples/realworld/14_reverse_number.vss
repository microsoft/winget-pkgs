note 14_reverse_number.vss — Reverse Digits of a Number
task reverse_num needs n
    make rev becomes 0
    make temp becomes n
    during temp above 0
        make digit becomes temp % 10
        rev becomes (rev * 10) + digit
        temp becomes math.floor(temp / 10)
    finish
    send rev
finish

say "Reverse of 12345: " + reverse_num(12345)
say "Reverse of 9870: " + reverse_num(9870)
