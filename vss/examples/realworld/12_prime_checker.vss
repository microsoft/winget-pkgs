note 12_prime_checker.vss — Prime Number Checker
task is_prime needs n
    when n at_most 1
        send no
    finish
    make i becomes 2
    during i * i at_most n
        when n % i same_as 0
            send no
        finish
        i becomes i + 1
    finish
    send yes
finish

say "Is 29 prime? " + is_prime(29)
say "Is 30 prime? " + is_prime(30)
