note 30_sqlite_crud.vss — SQLite Database Application
make db_file becomes "test.db"
make db becomes database.open(db_file)

database.execute(db, "CREATE TABLE users (id INT, name TEXT);")
database.execute(db, "INSERT INTO users VALUES (1, 'Alice');")
database.execute(db, "INSERT INTO users VALUES (2, 'Bob');")

make rows becomes database.query(db, "SELECT * FROM users;")
say "Query Results: " + rows

filesystem.delete_file(db_file)
