note 15_palindrome_number.vss — Palindrome Number Checker
task is_palindrome_num needs n
    make rev becomes 0
    make temp becomes n
    during temp above 0
        make digit becomes temp % 10
        rev becomes (rev * 10) + digit
        temp becomes math.floor(temp / 10)
    finish
    send rev same_as n
finish

say "Is 12321 palindrome? " + is_palindrome_num(12321)
say "Is 12345 palindrome? " + is_palindrome_num(12345)
