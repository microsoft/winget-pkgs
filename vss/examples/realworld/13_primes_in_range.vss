note 13_primes_in_range.vss — Prime Numbers in Range
task is_prime needs n
    when n at_most 1
        send no
    finish
    make i becomes 2
    during i * i at_most n
        when n % i same_as 0
            send no
        finish
        i becomes i + 1
    finish
    send yes
finish

say "Primes between 1 and 30:"
repeat n through 1 to 30
    when is_prime(n) same_as yes
        say n
    finish
finish
