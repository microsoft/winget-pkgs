note 26_file_reader.vss — File Reading Utility
make sample_path becomes "vss_sample.txt"
make sample_content becomes "Line 1: Hello VSS\nLine 2: File Handling\nLine 3: End of file"

filesystem.write_file(sample_path, sample_content)

when filesystem.exists_file(sample_path) same_as yes
    make text becomes filesystem.read_file(sample_path)
    say "File Content:"
    say text
    filesystem.delete_file(sample_path)
finish
