note 29_json_parser.vss — JSON Parser & Generator
make user_obj becomes map [
    "name": "Sai",
    "role": "Developer",
    "version": 3
]

make json_str becomes json.stringify(user_obj)
say "Serialized JSON: " + json_str

make parsed becomes json.parse(json_str)
say "Parsed Name: " + (parsed field "name")
say "Parsed Role: " + (parsed field "role")
