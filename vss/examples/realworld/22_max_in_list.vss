note 22_max_in_list.vss — Find Maximum & Minimum in List
task find_max_min needs items
    when size of items same_as 0
        say "List is empty"
        send empty
    finish
    
    make max_val becomes items[0]
    make min_val becomes items[0]
    
    repeat each x in items
        when x above max_val
            max_val becomes x
        finish
        when x below min_val
            min_val becomes x
        finish
    finish
    
    say "Maximum: " + max_val
    say "Minimum: " + min_val
finish

make nums becomes [45, 12, 89, 3, 67, 24]
find_max_min(nums)
