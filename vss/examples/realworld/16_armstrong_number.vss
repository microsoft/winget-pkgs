note 16_armstrong_number.vss — Armstrong Number Validator
task is_armstrong needs n
    make temp becomes n
    make sum becomes 0
    during temp above 0
        make digit becomes temp % 10
        sum becomes sum + (digit * digit * digit)
        temp becomes math.floor(temp / 10)
    finish
    send sum same_as n
finish

say "Is 153 Armstrong? " + is_armstrong(153)
say "Is 370 Armstrong? " + is_armstrong(370)
say "Is 123 Armstrong? " + is_armstrong(123)
