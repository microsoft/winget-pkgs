note 19_palindrome_string.vss — String Palindrome Checker
task is_palindrome_str needs s
    make lower_s becomes string.lower(s)
    make len becomes string.length(lower_s)
    make rev becomes ""
    repeat i through 1 to len
        make char_idx becomes len - i
        make ch becomes string.substring(lower_s, char_idx, char_idx + 1)
        rev becomes rev + ch
    finish
    send rev same_as lower_s
finish

say "Is 'racecar' palindrome? " + is_palindrome_str("racecar")
say "Is 'VSS' palindrome? " + is_palindrome_str("VSS")
