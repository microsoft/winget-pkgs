note 28_file_copier.vss — File Copier
make src_file becomes "source.txt"
make dest_file becomes "copy.txt"
make data becomes "VSS File Copier Test Data\n"

filesystem.write_file(src_file, data)

make content becomes filesystem.read_file(src_file)
filesystem.write_file(dest_file, content)

say "Copied data from " + src_file + " to " + dest_file
say "Copied Content: " + filesystem.read_file(dest_file)

filesystem.delete_file(src_file)
filesystem.delete_file(dest_file)
