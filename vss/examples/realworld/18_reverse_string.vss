note 18_reverse_string.vss — String Reversal
task reverse_str needs s
    make len becomes string.length(s)
    make rev becomes ""
    repeat i through 1 to len
        make char_idx becomes len - i
        make ch becomes string.substring(s, char_idx, char_idx + 1)
        rev becomes rev + ch
    finish
    send rev
finish

say "Reverse of 'Hello': " + reverse_str("Hello")
say "Reverse of 'VSS Language': " + reverse_str("VSS Language")
