note 05_pos_neg.vss — Positive, Negative, or Zero
task check_number needs num
    when num above 0
        say num + " is Positive"
    orwhen num below 0
        say num + " is Negative"
    otherwise
        say num + " is Zero"
    finish
finish

check_number(10)
check_number(-5)
check_number(0)
