note 24_search_list.vss — Linear Search
task linear_search needs items, target
    make idx becomes 0
    repeat each x in items
        when x same_as target
            send idx
        finish
        idx becomes idx + 1
    finish
    send -1
finish

make items becomes ["apple", "banana", "cherry", "date"]
say "Index of 'cherry': " + linear_search(items, "cherry")
say "Index of 'grape': " + linear_search(items, "grape")
