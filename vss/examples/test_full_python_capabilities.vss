note VSS Full Python Capability Alignment Test Suite

grab testing
grab encoding
grab path
grab random
grab datetime
grab regex

say "========================================"
say "VSS Expanded Python Capability Test Suite"
say "========================================"

say "1. Testing Base64 & Hex Encoding (base64/hex)..."
make raw_str becomes "VSS Programming Language 3.1"
make b64_enc becomes encoding.base64_encode(raw_str)
make b64_dec becomes encoding.base64_decode(b64_enc)
testing.assert_equal(b64_dec, raw_str, "Base64 encode/decode roundtrip")

make hex_enc becomes encoding.hex_encode("Hello")
make hex_dec becomes encoding.hex_decode(hex_enc)
testing.assert_equal(hex_dec, "Hello", "Hex encode/decode roundtrip")

say "2. Testing Cross-Platform Path Utilities (os.path)..."
make full_p becomes path.join("projects", "vss-language")
testing.assert_equal(full_p, "projects/vss-language", "path.join produces joined path")

make base_n becomes path.basename("projects/vss-language/main.vss")
testing.assert_equal(base_n, "main.vss", "path.basename extracts filename")

make dir_n becomes path.dirname("projects/vss-language/main.vss")
testing.assert_equal(dir_n, "projects/vss-language", "path.dirname extracts directory")

make ext_n becomes path.ext("projects/vss-language/main.vss")
testing.assert_equal(ext_n, ".vss", "path.ext extracts extension")

say "3. Testing Random & Sampling Utilities (random)..."
make r_val becomes random.randint(10, 20)
testing.assert_equal(r_val above 9, yes, "random.randint produces number >= min")
testing.assert_equal(r_val below 21, yes, "random.randint produces number <= max")

make picked becomes random.choice(["alpha", "beta", "gamma"])
testing.assert_equal(type_of(picked), "string", "random.choice selects item from list")

say "4. Testing Date & Time Utilities (datetime)..."
make current_dt becomes datetime.now()
testing.assert_equal(type_of(current_dt), "string", "datetime.now returns timestamp string")

make current_ts becomes datetime.timestamp()
testing.assert_equal(current_ts above 1000000000, yes, "datetime.timestamp returns unix timestamp")

say "5. Testing Regex Utilities (re)..."
make text_data becomes "Python and VSS language parity"
make is_match becomes regex.is_match("language", text_data)
testing.assert_equal(is_match, yes, "regex.is_match finds pattern match")

make replaced_text becomes regex.replace("Python", "VSS", "Python is powerful")
testing.assert_equal(replaced_text, "VSS is powerful", "regex.replace substitutes matched pattern")

say "========================================"
say "All Expanded Python Capability Tests Passed!"
say "========================================"
